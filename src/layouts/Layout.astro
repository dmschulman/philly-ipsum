---
import Head from '../components/Head.astro';
import Options from '../components/Options.astro';
import Footer from '../components/Footer.astro';

import background from '../assets/images/philadelphia-city-hall-sm.webp';
import backgroundDesktop from '../assets/images/philadelphia-city-hall.webp';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  nofollow?: boolean;
  defaultParagraphs: number;
  defaultSentences: number;
}

const isIndex = Astro.url.pathname === '/';

const {
  title,
  description,
  image,
  noindex = false,
  nofollow = false,
  defaultParagraphs = 3,
  defaultSentences = 4
} = Astro.props;
---

<!DOCTYPE html>
<html
  lang="en"
  style={`
    --background: url(${background.src});
    --backgroundDesktop: url(${backgroundDesktop.src});
  `}
>
  <Head title={title} description={description} image={image} noindex={noindex} nofollow={nofollow} />
  <body>
    <header>
      <h1>Philly Ipsum.com</h1>
	    <p class="intro">🎵 Move closer to your world 🎵</p>
      {isIndex && (
        <Options
          defaultParagraphs={defaultParagraphs}
          defaultSentences={defaultSentences}
        />
      )}
    </header>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style lang="scss" is:global>
  @use '../styles/breakpoints.scss' as *;

  html {
    font-size: 16px;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    background-image: var(--background);
    background-color: #666666;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    background-attachment: fixed;

    @include bp(tablet) {
      font-size: 18px;
      background-image: var(--backgroundDesktop);
    }
      
    body {
      position: relative;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-wrap: nowrap;
      height: 100vh;

      header {
        width: calc(100% - 4%);
        margin: 1rem 2% 4rem;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;

        @include bp(tablet) {
          margin: 2rem 5% 5rem;
          width: calc(100% - 10%);
        }

        h1 {
          margin: 0 auto 0.5rem;
          text-shadow: 1px 3px 1px #010101;
        }

        p.intro {
          text-align: center;
          margin: 0 auto 1rem;
          text-shadow: 1px 3px 1px #010101;
        }
      }

      main {
        display: flex;
        flex: 1;
        flex-direction: column;
        justify-content: stretch;
        align-items: stretch;
        width: calc(100% - 2rem);
        margin: 0 2%;
        min-height: 0;

        @include bp(tablet) {
          margin: 0 5%;
          width: calc(100% - 10%);
        }
      }

      footer {
        width: calc(100% - 4%);
        margin: 2rem 2% 1rem;

        @include bp(tablet) {
          width: calc(100% - 10%);
          margin: 5rem 5% 1rem;
        }
      }
    }
  }
</style>