---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import background from '../assets/images/philadelphia-city-hall-sm.webp';
import backgroundDesktop from '../assets/images/philadelphia-city-hall.webp';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!DOCTYPE html>
<html
  lang="en"
  style={`
    --background: url(${background.src});
    --backgroundDesktop: url(${backgroundDesktop.src});
  `}
>
  <Head title={title} description={description} image={image} />
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style lang="scss" is:global>
  @use '../styles/breakpoints.scss' as *;

  html {
    font-size: 16px;
    color: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    background-image: var(--background);
    background-color: #666666;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    background-attachment: fixed;

    @include bp(tablet) {
      font-size: 18px;
      background-image: var(--backgroundDesktop);
    }
      
    body {
      position: relative;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      flex-wrap: nowrap;
      min-height: 100vh;

      header {
        margin: 2rem 2% 3rem;

        @include bp(tablet) {
          margin: 2rem 5% 3rem;
        }

      }

      main {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        margin: 2rem 2%;

        @include bp(tablet) {
          margin: 2rem 5%;
        }
      }

      footer {
        margin: 2rem 2% 1rem;

        @include bp(tablet) {
          margin: 2rem 5% 1rem;
        }
      }
    }
  }
</style>