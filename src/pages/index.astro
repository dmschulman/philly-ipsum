---
import { words } from '../lib/words.js';
import { buildGenerator } from '../lib/generator.js';

import Layout from '../layouts/Layout.astro';

const paragraphs = 3;
const sentences = 4;

const { output } = buildGenerator(words);
const initial = output(paragraphs, sentences);
---

<Layout title="Philly Sentence Generator">

  <textarea id="output" readonly>{initial.join('\n\n')}</textarea>

  <script id="words-data" type="application/json" set:html={JSON.stringify(words)}></script>

  <script>
    import '../scripts/main.js';
  </script>
</Layout>

<style lang="scss" is:global>
  @use '../styles/breakpoints.scss' as *;

  textarea {
    resize: none;
    display: block;
    min-height: 360px;
    min-width: calc(320px - 2rem);
    width: 90vw;
    border: 1px dashed #010101;
    padding: 1rem;
    text-align: left;
    background: #ffffff;
    color: #010101;
    margin: 0 auto;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1rem;

    @include bp(tablet) {
      width: calc(70vw - 10%);
      min-width: 700px;
      min-height: 500px;
      resize: vertical;
    }
  }
</style>