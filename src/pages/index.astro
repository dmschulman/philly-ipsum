---
import { words } from '../lib/words.js';
import { buildGenerator } from '../lib/generator.js';

import Layout from '../layouts/Layout.astro';

const paragraphs = 3;
const sentences = 4;

const { output } = buildGenerator(words);
const initial = output(paragraphs, sentences);
---

<Layout
  title="Philly Ipsum.com - Yeet that jawn"
	description="The lorem ipsum generator of brotherly love and sisterly affection. Create Philly-centric placeholder text for your next big design project or website."
>
  <label for="output" class="visually-hidden"></label>
  <textarea id="output" aria-label="Generated text" readonly>{initial.join('\n\n')}</textarea>

  <script id="words-data" type="application/json" set:html={JSON.stringify(words)}></script>

  <script>
    import '../scripts/main.js';
  </script>
</Layout>

<style lang="scss" is:global>
  @use '../styles/breakpoints.scss' as *;

  label {
    &.visually-hidden {
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      white-space: nowrap;
      border: 0;
    }
  }

  textarea {
    box-sizing: border-box;
    flex: 1;
    resize: none;
    width: 100%;
    min-width: 320px;
    min-height: 200px;
    max-width: 1200px;
    border: 1px solid #010101;
    margin: 0 auto;
    box-shadow: 10px 10px 20px 2px #333;
    padding: 1rem;
    text-align: left;
    background: #ffffff;
    opacity: .9;
    color: #010101;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1rem;

    @include bp(tablet) {
      min-width: 700px;
    }
  }
</style>