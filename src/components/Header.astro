---
import Options from '../components/Options.astro';

const { defaultParagraphs = 3, defaultSentences = 4 } = Astro.props;
---

<header>
	<h1>Philly Ipsum.com</h1>
	<p class="intro">🎵 Move closer to your world 🎵</p>
  <Options
    defaultParagraphs={defaultParagraphs}
    defaultSentences={defaultSentences}
  />
</header>

<style lang="scss">
	@use '../styles/breakpoints.scss' as *;

	header {
		display: flex;
		flex-direction: column;
		justify-content: center;

		h1 {
			margin: 0 auto 0.5rem;
			text-shadow: 1px 3px 1px #010101;
		}

		p.intro {
			text-align: center;
			margin: 0 auto 1rem;
			text-shadow: 1px 3px 1px #010101;
		}
	}
</style>