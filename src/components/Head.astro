---
import { SEO } from "astro-seo";
import background from '../assets/images/philadelphia-city-hall-sm.webp';
import backgroundDesktop from '../assets/images/philadelphia-city-hall.webp';

interface Props {
  title?: string;
  description?: string;
  image?: string;
	noindex: boolean;
	nofollow: boolean;
}

const {
	title = 'Philly Ipsum.com - Yeet that jawn',
	description = 'The lorem ipsum generator of brotherly love and sisterly affection. Create Philly-centric placeholder text for your next big design project or website.',
  image = '/og-image.jpg',
	noindex = false,
	nofollow = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const socialImage = new URL(image, Astro.site).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Philly Ipsum',
  url: canonicalURL,
  description,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any',
  author: {
    '@type': 'Person',
    name: 'David M. Schulman',
    url: 'https://dmschulman.com',
  },
};
---

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />

	<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="shortcut icon" href="/favicon.ico" />
	<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
	<meta name="apple-mobile-web-app-title" content="Philly Ipsum" />
	<link rel="manifest" href="/site.webmanifest" />

	<link rel="preload" as="image" href={backgroundDesktop.src} media="(min-width: 800px)" fetchpriority="high" />
	<link rel="preload" as="image" href={background.src} media="(max-width: 799px)" fetchpriority="high" />

	<SEO
		title={title}
		description={description}
		canonical={canonicalURL}
		noindex={noindex}
    nofollow={nofollow}
		openGraph={{
			basic: {
				title,
				type: 'website',
				image: socialImage,
				url: canonicalURL,
			},
			optional: {
				siteName: 'Philly Ipsum.com - Yeet that jawn',
				description: 'The lorem ipsum generator of brotherly love and sisterly affection. Create Philly-centric placeholder text for your next big design project or website.',
				locale: 'en_US',
			},
			image: {
				width: 1200,
				height: 630,
				alt: 'The large stone facade of Philadelphia City Hall at night as streaming lights from passing cars go by',
			},
		}}
		twitter={{
			card: 'summary_large_image',
			site: '@dmschulman',
			creator: '@dmschulman',
			title,
			description,
			image: socialImage,
			imageAlt: 'The large stone facade of Philadelphia City Hall at night as streaming lights from passing cars go by',
		}}
		extend={{
			link: [
				{ rel: 'sitemap', type: 'application/xml', href: '/sitemap-index.xml' },
			],
			meta: [
				{ name: 'theme-color', content: '#666666' },
				{ name: 'generator', content: Astro.generator },
			],
		}}
	/>

	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

	{
		import.meta.env.PROD && (
			<>
				<script async src="https://www.googletagmanager.com/gtag/js?id=G-P5XJHHJXFG"></script>
				<script async>
					window.dataLayer = window.dataLayer || [];
					function gtag() {
						dataLayer.push(arguments);
					}
					gtag('js', new Date());

					gtag('config', 'G-P5XJHHJXFG');
				</script>
			</>
		)
	}
</head>